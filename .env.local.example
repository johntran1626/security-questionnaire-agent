# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# Which provider the agent uses: anthropic | google
AI_PROVIDER=anthropic

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high | minimal | off
GEMINI_THINKING=low

# Anthropic Console key (https://platform.claude.com)
ANTHROPIC_API_KEY=
# claude-haiku-5-5 for the public demo (lowest cost); claude-sonnet-5-5 for comparison runs
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high
ANTHROPIC_EFFORT=low

# Rate limiting for the public demo. Without Upstash, an in-memory limiter is used (fine locally, not on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Limits count questions, not runs: a 50-question run uses 50.
QUESTIONS_PER_HOUR_PER_IP=100
DAILY_QUESTION_CAP=300
RATE_LIMIT_SALT=change-me

# Local evaluation only: enables baseline modes and per-request provider choice. Leave unset in production.
ENABLE_EVAL_MODES=
